# Copy these into your host's environment variables (Vercel: Project Settings > Environment Variables).
# Never commit a real .env file.
ANTHROPIC_API_KEY=your-key-here
# Shared password the chatters type into the site. Set it so strangers cant spend your API credits.
APP_PASSWORD=pick-something-long
# Optional. Defaults to claude-sonnet-5-5
# ANTHROPIC_MODEL=claude-sonnet-5-5
